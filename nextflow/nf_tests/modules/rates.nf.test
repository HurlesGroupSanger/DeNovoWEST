nextflow_process {

    name "Test Process GFFUTILS_DB"
    script "modules/rates.nf"
    process "GFFUTILS_DB"

    test("Should create a gffutils database") {

        when {
            process {
                """
                input[0] = file("$baseDir/nf_tests/test_data/rates/create_gffutils_db/b37/input/Homo_sapiens.GRCh37.87.DDX3X_SCN5A.gff3")
                """
            }
        }

        then {
            //check if test case succeeded
            assert process.success
            //analyze trace file
            assert process.trace.tasks().size() == 1

            // SQLite databases are not byte-for-byte reproducible across library versions,
            // so we validate content rather than MD5
            with(process.out.gffutils_db_ch) {
                assert path(get(0)).exists()
                assert path(get(0)).size() > 0
                // Verify it is a SQLite3 file by checking the magic header bytes
                assert path(get(0)).bytes[0..14] == "SQLite format 3".bytes.toList()
            }
        }
    }
}