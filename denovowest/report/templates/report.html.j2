<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title }}</title>
  <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
  <link rel="stylesheet"
        href="https://cdn.datatables.net/2.0.8/css/dataTables.bootstrap5.min.css" />
  <style>
    body { font-size: 0.9rem; }
    .gene-row { cursor: pointer; }
    .gene-row:hover td { background-color: #e9ecef; }
    .detail-cell { padding: 1rem 1.5rem !important; background: #f8f9fa !important; width: 100%; }
    .detail-sections { display: flex; flex-wrap: wrap; gap: 1rem; margin-bottom: 1rem; }
    .detail-section  { min-width: 180px; }
    .detail-section-grow { flex: 1; min-width: 300px; }
    .expand-icon { display: inline-block; transition: transform 0.15s; margin-right: 4px; }
    tr.expanded .expand-icon { transform: rotate(90deg); }
    .pval-significant { color: #198754; font-weight: 600; }
    .pval-nominal     { color: #fd7e14; }
    .pval-ns       { color: #6c757d; }
    .pval-na       { color: #adb5bd; font-style: italic; }
    .csq-table th, .csq-table td { font-size: 0.8rem; padding: 0.25rem 0.5rem; }
    .zero-val { color: #dc3545; font-weight: 600; }
    .summary-strip { border-left: 4px solid; }
    .strip-total   { border-color: #6c757d; }
    .strip-sig     { border-color: #198754; }
    .strip-caution { border-color: #fd7e14; }
    .g2p-definitive { background-color: #0a5c2e; color: #fff; }
    .g2p-strong     { background-color: #198754; color: #fff; }
    .g2p-moderate   { background-color: #5cb383; color: #fff; }
    .g2p-limited    { background-color: #fd7e14; color: #fff; }
    .g2p-disputed   { background-color: #fd7e14; color: #fff; }
    .g2p-refuted    { background-color: #dc3545; color: #fff; }
    .g2p-absent     { background-color: #adb5bd; color: #fff; }
    /* Biallelic-only G2P entries get a dashed outline to distinguish them from monoallelic */
    .g2p-biallelic  { outline: 2px dashed #000; outline-offset: 2px; }
    /* Collapsible DNM variant list (significant genes only) */
    .dnm-toggle { cursor: pointer; user-select: none; list-style: none; }
    .dnm-toggle::-webkit-details-marker { display: none; }
    .dnm-toggle::before { content: '▶\00a0'; font-size: 0.7em; }
    details[open] .dnm-toggle::before { content: '▼\00a0'; font-size: 0.7em; }
  </style>
</head>
<body>

<nav class="navbar navbar-dark bg-dark mb-4">
  <div class="container-fluid">
    <span class="navbar-brand fw-bold">DeNovoWEST &mdash; Results Report</span>
    <span class="text-white-50 small text-truncate ms-2" style="max-width:55%">{{ results_dir }}</span>
    <span class="text-white-50 small ms-auto text-nowrap">Generated: {{ run_date }}</span>
  </div>
</nav>

<div class="container-fluid px-4">

  {# ── Summary strip ──────────────────────────────────────────────────────── #}
  <div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
      <div class="card summary-strip strip-total">
        <div class="card-body py-2">
          <div class="text-muted small">Genes tested</div>
          <div class="fs-3 fw-bold">{{ n_total }}</div>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card summary-strip strip-sig">
        <div class="card-body py-2">
          <div class="text-muted small">
            Significant <span class="fw-normal">(min&nbsp;p&nbsp;&lt;&nbsp;{{ corrected_threshold }})</span>
          </div>
          <div class="fs-3 fw-bold text-success">{{ n_significant }}</div>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card summary-strip strip-caution">
        <div class="card-body py-2">
          <div class="text-muted small">Flagged with caution</div>
          <div class="fs-3 fw-bold text-warning">{{ n_caution }}</div>
        </div>
      </div>
    </div>
  </div>

  {# ── Gene table ─────────────────────────────────────────────────────────── #}
  <div class="card mb-4">
    <div class="card-header fw-semibold">
      Gene enrichment results
      <span class="text-muted fw-normal small ms-2">— click a row to expand details</span>
    </div>
    <div class="card-body p-0">
      <table id="gene-table" class="table table-sm table-hover mb-0" style="width:100%">
        <thead class="table-light">
          <tr>
            <th></th>
            <th>Gene ID</th>
            <th>Symbol</th>
            <th>G2P</th>
            <th>min p-val</th>
            <th>Enrich. all</th>
            <th>Enrich. mis</th>
            <th>Comb. mis</th>
            <th>Clustering</th>
            <th>Obs / Exp (all)</th>
            <th>Obs / Exp (mis)</th>
            <th>Caution</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </div>
  </div>

  <p class="text-muted small mb-2">
    <strong>p-value colour scale:</strong>
    <span class="pval-significant">&#9632; &lt; {{ corrected_threshold }} (corrected)</span> &nbsp;
    <span class="pval-nominal">&#9632; &lt; {{ nominal_threshold }} (nominal)</span> &nbsp;
    <span class="pval-ns">&#9632; &ge; {{ nominal_threshold }}</span> &nbsp;
    <span class="pval-na">&#9632; N/A</span>
  </p>
  <p class="text-muted small mb-4">
    <strong>G2P badge:</strong>
    filled = monoallelic (dominant) entry present &nbsp;|&nbsp;
    <span style="outline:2px dashed #000;outline-offset:2px;padding:0 3px">dashed outline</span> = biallelic (recessive) only
  </p>

</div>{# /container #}

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/2.0.8/js/dataTables.min.js"></script>
<script src="https://cdn.datatables.net/2.0.8/js/dataTables.bootstrap5.min.js"></script>
<script>
const GENES = {{ gene_json | safe }};
const CORRECTED_THRESHOLD = {{ corrected_threshold }};
const NOMINAL_THRESHOLD    = {{ nominal_threshold }};

// ── Formatting helpers ────────────────────────────────────────────────────────

function fmtPval(v) {
  if (v === null || v === undefined) return '<span class="pval-na">N/A</span>';
  const cls = v < CORRECTED_THRESHOLD ? 'pval-significant'
            : v < NOMINAL_THRESHOLD   ? 'pval-nominal'
            :                           'pval-ns';
  return `<span class="${cls}">${v.toExponential(2)}</span>`;
}

function fmtNum(v, dp) {
  return v !== null && v !== undefined
    ? v.toFixed(dp)
    : '<span class="text-muted">N/A</span>';
}

function fmtRatio(obs, exp) {
  if (obs === null || exp === null) return '<span class="text-muted">N/A</span>';
  return `${obs.toFixed(1)} / ${exp.toFixed(1)}`;
}

// ── Detail panel ──────────────────────────────────────────────────────────────

function buildDetailHtml(gene) {
  const cautionHtml = gene.caution_reasons.length > 0
    ? `<div class="alert alert-warning py-2 mb-3 small">
         <strong>&#9888; Caution:</strong> ${gene.caution_reasons.join('; ')}
       </div>`
    : '';

  const ensemblHref =
    `https://www.ensembl.org/Homo_sapiens/Gene/Summary?g=${gene.base_id}`;

  // DNM counts per consequence from simulation log (sorted descending by expected count)
  const simCsqHtml = gene.sim_expected_per_csq
    ? (() => {
        const hasObs = gene.obs_per_csq !== null;
        const header = hasObs
          ? '<tr><th>Consequence</th><th>Observed</th><th>Expected</th></tr>'
          : '<tr><th>Consequence</th><th>Expected DNMs</th></tr>';
        const rows = Object.entries(gene.sim_expected_per_csq)
          .sort((a, b) => b[1] - a[1])
          .map(([csq, exp]) => {
            const obs = hasObs ? (gene.obs_per_csq[csq] ?? 0) : null;
            const obsCell = hasObs ? `<td>${obs}</td>` : '';
            return `<tr><td><code>${csq}</code></td>${obsCell}<td>${exp.toFixed(3)}</td></tr>`;
          })
          .join('');
        return `
          <div class="detail-section-grow">
            <div class="fw-semibold small text-muted mb-1">DNM counts per consequence</div>
            <table class="table table-sm table-bordered csq-table mb-0">
              <thead class="table-light">${header}</thead>
              <tbody>${rows}</tbody>
            </table>
          </div>`;
      })()
    : '';

  const statsHtml = `
    <div class="detail-sections">
      <div class="detail-section">
        <div class="fw-semibold small text-muted mb-1">DNM counts</div>
        <table class="table table-sm table-bordered csq-table mb-0">
          <thead class="table-light"><tr><th>Metric</th><th>Value</th></tr></thead>
          <tbody>
            <tr><td>Observed</td> <td>${gene.nb_observed_dnms !== null ? gene.nb_observed_dnms : '<span class="text-muted">N/A</span>'}</td></tr>
            <tr><td>Expected</td> <td>${fmtNum(gene.nb_expected_dnms, 2)}</td></tr>
          </tbody>
        </table>
      </div>
      ${simCsqHtml}
      <div class="detail-section">
        <div class="fw-semibold small text-muted mb-1">Clustering</div>
        <table class="table table-sm table-bordered csq-table mb-0">
          <thead class="table-light"><tr><th>Metric</th><th>Value</th></tr></thead>
          <tbody>
            <tr><td>Distance</td> <td>${fmtNum(gene.clustering_dist, 1)}</td></tr>
          </tbody>
        </table>
      </div>
    </div>`;

  // Per-variant DNM table — only present for significant genes
  const dnmListHtml = gene.observed_dnms
    ? (() => {
        const CSQ_COLOURS = {
          missense: '#0d6efd', nonsense: '#dc3545', frameshift: '#dc3545',
          splice_lof: '#fd7e14', splice_region: '#ffc107', inframe: '#6f42c1',
          start_lost: '#d63384', stop_lost: '#d63384', synonymous: '#6c757d',
          stop_retained: '#6c757d',
        };
        const rows = gene.observed_dnms.map(v => {
          const col = CSQ_COLOURS[v.consequence] ?? '#6c757d';
          const csqBadge = `<span style="color:${col};font-weight:600">${v.consequence}</span>`;
          return `<tr>
            <td>${v.chrom}</td>
            <td>${v.pos.toLocaleString()}</td>
            <td><code>${v.ref}&gt;${v.alt}</code></td>
            <td>${csqBadge}</td>
            <td>${v.score.toFixed(3)}</td>
          </tr>`;
        }).join('');
        return `
          <details class="mt-1">
            <summary class="dnm-toggle small fw-semibold text-muted">
              ${gene.observed_dnms.length} observed variant${gene.observed_dnms.length !== 1 ? 's' : ''}
            </summary>
            <div class="mt-2">
              <table class="table table-sm table-bordered csq-table mb-0">
                <thead class="table-light">
                  <tr><th>Chrom</th><th>Pos</th><th>Allele</th><th>Consequence</th><th>Score</th></tr>
                </thead>
                <tbody>${rows}</tbody>
              </table>
            </div>
          </details>`;
      })()
    : '';

  const symbolHtml = gene.gene_symbol
    ? `<span class="text-muted fw-normal">(${gene.gene_symbol})</span>`
    : '';

  const conf = gene.g2p_confidence ?? 'absent';
  const req  = gene.g2p_allelic_requirement ?? 'absent';
  const isBiallelic = req === 'biallelic' || req.startsWith('biallelic_');
  const g2pBadge = conf !== 'absent'
    ? `<span class="badge g2p-${conf}${isBiallelic ? ' g2p-biallelic' : ''}" title="${req}">${conf}${isBiallelic ? ' (biallelic)' : ''}</span>`
    : '';

  return `
    <div class="d-flex align-items-center gap-2 mb-2">
      <span class="fw-bold">${gene.gene_id}</span>
      ${symbolHtml}
      ${g2pBadge}
      <a href="${ensemblHref}" target="_blank" class="small text-decoration-none">
        Ensembl &#8599;
      </a>
    </div>
    ${cautionHtml}
    ${statsHtml}
    ${dnmListHtml}`;
}

// ── DataTables ────────────────────────────────────────────────────────────────

$(document).ready(function () {
  const table = $('#gene-table').DataTable({
    data: GENES,
    order: [[4, 'asc']],
    pageLength: 25,
    language: { search: 'Filter genes:' },
    columns: [
      {
        data: null,
        orderable: false,
        className: 'dt-center',
        defaultContent: '<span class="expand-icon">&#9654;</span>',
      },
      { data: 'gene_id', title: 'Gene ID' },
      {
        data: 'gene_symbol', title: 'Symbol',
        render: d => d ?? '<span class="text-muted">—</span>',
      },
      {
        data: 'g2p_confidence', title: 'G2P',
        render: (d, type, row) => {
          const RANK = { definitive:0, strong:1, moderate:2, limited:3, disputed:4, refuted:5, absent:6 };
          if (type === 'sort') return d !== null ? (RANK[d] ?? 99) : 99;
          const conf = d ?? 'absent';
          const req  = row.g2p_allelic_requirement ?? 'absent';
          const isBiallelic = req === 'biallelic' || req.startsWith('biallelic_');
          const badgeCls = `badge g2p-${conf}${isBiallelic ? ' g2p-biallelic' : ''}`;
          const label    = isBiallelic
            ? `<br><span style="font-size:0.7em;color:#6c757d">biallelic</span>`
            : '';
          return `<span class="${badgeCls}">${conf}</span>${label}`;
        },
      },
      {
        data: 'min_pval', title: 'min p-val',
        render: (d, type) => type === 'sort' ? (d ?? 999) : fmtPval(d),
      },
      {
        data: 'enrichment_all_pval', title: 'Enrich. all',
        render: (d, type) => type === 'sort' ? (d ?? 999) : fmtPval(d),
      },
      {
        data: 'enrichment_mis_pval', title: 'Enrich. mis',
        render: (d, type) => type === 'sort' ? (d ?? 999) : fmtPval(d),
      },
      {
        data: 'combined_mis_pval', title: 'Comb. mis',
        render: (d, type) => type === 'sort' ? (d ?? 999) : fmtPval(d),
      },
      {
        data: 'clustering_pval', title: 'Clustering',
        render: (d, type) => type === 'sort' ? (d ?? 999) : fmtPval(d),
      },
      {
        data: null, orderable: false,
        render: d => fmtRatio(d.observed_all, d.expected_all),
      },
      {
        data: null, orderable: false,
        render: d => fmtRatio(d.observed_mis, d.expected_mis),
      },
      {
        data: 'caution', orderable: true,
        render: (d, type, row) => {
          if (type === 'sort') return d ? 0 : 1;
          if (!d) return '<span class="text-muted">—</span>';
          const tip = row.caution_reasons.join('; ');
          return `<span class="badge bg-warning text-dark"
                        title="${tip}" style="cursor:help">&#9888; Caution</span>`;
        },
      },
    ],
    createdRow: function (row, data) {
      $(row).addClass('gene-row');
      if (data.min_pval !== null && data.min_pval < CORRECTED_THRESHOLD) {
        $(row).addClass('table-success bg-opacity-25');
      }
    },
  });

  // Toggle child row on click
  $('#gene-table tbody').on('click', 'tr.gene-row', function () {
    const tr  = $(this);
    const row = table.row(tr);
    if (row.child.isShown()) {
      row.child.hide();
      tr.removeClass('expanded table-active');
    } else {
      row.child(
        $('<td class="detail-cell" colspan="12">').append(buildDetailHtml(row.data()))
      ).show();
      tr.addClass('expanded table-active');
    }
  });
});
</script>
</body>
</html>
