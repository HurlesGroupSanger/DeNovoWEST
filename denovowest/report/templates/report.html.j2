<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title }}</title>
  <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
  <link rel="stylesheet"
        href="https://cdn.datatables.net/2.0.8/css/dataTables.bootstrap5.min.css" />
  <style>
    body { font-size: 0.9rem; }
    .gene-row { cursor: pointer; }
    .gene-row:hover td { background-color: #e9ecef; }
    .detail-cell { padding: 1rem 1.5rem !important; background: #f8f9fa !important; width: 100%; }
    .detail-sections { display: flex; flex-wrap: wrap; gap: 1rem; margin-bottom: 1rem; }
    .detail-section  { min-width: 180px; }
    .detail-section-grow { flex: 1; min-width: 300px; }
    .expand-icon { display: inline-block; transition: transform 0.15s; margin-right: 4px; }
    tr.expanded .expand-icon { transform: rotate(90deg); }
    .pval-significant { color: #198754; font-weight: 600; }
    .pval-nominal     { color: #fd7e14; }
    .pval-ns       { color: #6c757d; }
    .pval-na       { color: #adb5bd; font-style: italic; }
    .csq-table th, .csq-table td { font-size: 0.8rem; padding: 0.25rem 0.5rem; }
    .zero-val { color: #dc3545; font-weight: 600; }
    .summary-strip { border-left: 4px solid; }
    .strip-total   { border-color: #6c757d; }
    .strip-sig     { border-color: #198754; }
    .strip-caution { border-color: #fd7e14; }
    .g2p-definitive { background-color: #0a5c2e; color: #fff; }
    .g2p-strong     { background-color: #198754; color: #fff; }
    .g2p-moderate   { background-color: #5cb383; color: #fff; }
    .g2p-limited    { background-color: #fd7e14; color: #fff; }
    .g2p-disputed   { background-color: #fd7e14; color: #fff; }
    .g2p-refuted    { background-color: #dc3545; color: #fff; }
    .g2p-absent     { background-color: #adb5bd; color: #fff; }
    /* Biallelic-only G2P entries get a dashed outline to distinguish them from monoallelic */
    .g2p-biallelic  { outline: 2px dashed #000; outline-offset: 2px; }
    /* Column header abbreviations show a help cursor to hint at the tooltip */
    th abbr { cursor: help; text-decoration: underline dotted #6c757d; }
    /* Collapsible DNM variant list (significant genes only) */
    .dnm-toggle { cursor: pointer; user-select: none; list-style: none; }
    .dnm-toggle::-webkit-details-marker { display: none; }
    .dnm-toggle::before { content: '▶\00a0'; font-size: 0.7em; }
    details[open] .dnm-toggle::before { content: '▼\00a0'; font-size: 0.7em; }
    /* Source-list panel badges — color applied per-badge via inline style */
    .src-badge { font-size: 0.75em; }
  </style>
</head>
<body>

<nav class="navbar navbar-dark bg-dark mb-4">
  <div class="container-fluid">
    <span class="navbar-brand fw-bold">DeNovoWEST &mdash; Results Report</span>
    <span class="text-white-50 small text-truncate ms-2" style="max-width:45%">{{ results_dir }}</span>
    <span class="text-white-50 small ms-auto text-nowrap">v{{ report_version }} &nbsp;&bull;&nbsp; Generated: {{ run_date }}</span>
  </div>
</nav>

<div class="container-fluid px-4">

  {# ── Summary strip ──────────────────────────────────────────────────────── #}
  <div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
      <div class="card summary-strip strip-total">
        <div class="card-body py-2">
          <div class="text-muted small">Genes tested</div>
          <div class="fs-3 fw-bold">{{ n_total }}</div>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card summary-strip strip-sig">
        <div class="card-body py-2">
          <div class="text-muted small">
            Significant <span class="fw-normal">(min&nbsp;p&nbsp;&lt;&nbsp;{{ corrected_threshold }})</span>
          </div>
          <div class="fs-3 fw-bold text-success">{{ n_significant }}</div>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card summary-strip strip-caution">
        <div class="card-body py-2">
          <div class="text-muted small">Flagged with caution</div>
          <div class="fs-3 fw-bold text-warning">{{ n_caution }}</div>
        </div>
      </div>
    </div>
  </div>

  {# ── Gene table ─────────────────────────────────────────────────────────── #}
  <div class="card mb-4">
    <div class="card-header fw-semibold">
      Gene enrichment results
      <span class="text-muted fw-normal small ms-2">— click a row to expand details</span>
    </div>
    <div class="card-body p-0">
      <table id="gene-table" class="table table-sm table-hover mb-0" style="width:100%">
        <thead class="table-light"><tr></tr></thead>
        <tbody></tbody>
      </table>
    </div>
  </div>

  <p class="text-muted small mb-1">
    <strong>p-value colour scale:</strong>
    <span class="pval-significant">&#9632; &lt; {{ corrected_threshold }} (corrected)</span> &nbsp;
    <span class="pval-nominal">&#9632; &lt; {{ nominal_threshold }} (nominal)</span> &nbsp;
    <span class="pval-ns">&#9632; &ge; {{ nominal_threshold }}</span> &nbsp;
    <span class="pval-na">&#9632; N/A</span>
  </p>
  <p class="text-muted small mb-1">
    <strong>G2P badge:</strong>
    filled = monoallelic (dominant) entry present &nbsp;|&nbsp;
    <span style="outline:2px dashed #000;outline-offset:2px;padding:0 3px">dashed outline</span> = biallelic (recessive) only
  </p>
  <p class="text-muted small mb-1">
    <strong>Obs / Exp columns</strong> show the sum of per-variant effect predictor scores, <em>not</em> raw DNM counts.
    Each variant contributes according to its predicted pathogenicity; a single high-scoring variant can exceed the expected sum even without excess counts.
    Raw observed / expected variant counts are shown in the per-gene detail panel.
  </p>
  <p class="text-muted small mb-4">
    <strong>Column tooltips:</strong> hover over any underlined column header for a description of the metric.
  </p>

</div>{# /container #}

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/2.0.8/js/dataTables.min.js"></script>
<script src="https://cdn.datatables.net/2.0.8/js/dataTables.bootstrap5.min.js"></script>
<script>
const GENES = {{ gene_json | safe }};
const CORRECTED_THRESHOLD  = {{ corrected_threshold }};
const NOMINAL_THRESHOLD    = {{ nominal_threshold }};
// Effect predictor column names extracted from the simulation logs (null when unavailable)
const SCORE_PREDICTOR      = {{ score_predictor | tojson }};
const MIS_SCORE_PREDICTOR  = {{ mis_score_predictor | tojson }};

// ── Formatting helpers ────────────────────────────────────────────────────────

// Assign palette colors to panel names in sorted alphabetical order for consistent mapping
const _SRC_PALETTE = ['#1565c0', '#c62828', '#6a1b9a', '#e65100'];
const _srcColorMap = Object.fromEntries(
  [...new Set(GENES.flatMap(g => g.source_lists || []))].sort()
    .map((name, i) => [name, _SRC_PALETTE[i % _SRC_PALETTE.length]])
);
function srcBadgeHtml(name) {
  const bg = _srcColorMap[name] ?? _SRC_PALETTE[0];
  return `<span class="badge src-badge" style="background-color:${bg};color:#fff">${name}</span>`;
}

function fmtPval(v) {
  if (v === null || v === undefined) return '<span class="pval-na">N/A</span>';
  const cls = v < CORRECTED_THRESHOLD ? 'pval-significant'
            : v < NOMINAL_THRESHOLD   ? 'pval-nominal'
            :                           'pval-ns';
  return `<span class="${cls}">${v.toExponential(2)}</span>`;
}

function fmtNum(v, dp) {
  return v !== null && v !== undefined
    ? v.toFixed(dp)
    : '<span class="text-muted">N/A</span>';
}

function fmtRatio(obs, exp) {
  if (obs === null || exp === null) return '<span class="text-muted">N/A</span>';
  return `${obs.toFixed(1)} / ${exp.toFixed(1)}`;
}

// ── Detail panel ──────────────────────────────────────────────────────────────

function buildDetailHtml(gene) {
  const cautionHtml = gene.caution_reasons.length > 0
    ? `<div class="alert alert-warning py-2 mb-3 small">
         <strong>&#9888; Caution:</strong>
         <ul class="mb-0 mt-1 ps-3">
           ${gene.caution_reasons.map(r => `<li>${r}</li>`).join('')}
         </ul>
       </div>`
    : '';

  const ensemblHref =
    `https://www.ensembl.org/Homo_sapiens/Gene/Summary?g=${gene.base_id}`;

  // DNM counts per consequence from simulation log (sorted descending by expected count)
  const simCsqHtml = gene.sim_expected_per_csq
    ? (() => {
        const hasObs = gene.obs_per_csq !== null;
        const header = hasObs
          ? '<tr><th>Consequence</th><th>Observed</th><th>Expected</th></tr>'
          : '<tr><th>Consequence</th><th>Expected DNMs</th></tr>';
        const rows = Object.entries(gene.sim_expected_per_csq)
          .sort((a, b) => b[1] - a[1])
          .map(([csq, exp]) => {
            const obs = hasObs ? (gene.obs_per_csq[csq] ?? 0) : null;
            const obsCell = hasObs ? `<td>${obs}</td>` : '';
            return `<tr><td><code>${csq}</code></td>${obsCell}<td>${exp.toFixed(3)}</td></tr>`;
          })
          .join('');
        return `
          <div class="detail-section-grow">
            <div class="fw-semibold small text-muted mb-1">DNM counts per consequence</div>
            <table class="table table-sm table-bordered csq-table mb-0">
              <thead class="table-light">${header}</thead>
              <tbody>${rows}</tbody>
            </table>
          </div>`;
      })()
    : '';

  // All-coding scores per consequence (observed = sum of scores per csq; expected = rate-weighted sum)
  const simScoreHtml = gene.sim_expected_score_per_csq
    ? (() => {
        const predictorLabel = SCORE_PREDICTOR ?? 'Score';
        const hasObs = gene.obs_score_per_csq !== null && gene.obs_score_per_csq !== undefined;
        const rows = Object.entries(gene.sim_expected_score_per_csq)
          .sort((a, b) => b[1] - a[1])
          .map(([csq, exp]) => {
            const obs = hasObs ? (gene.obs_score_per_csq[csq] ?? 0) : null;
            const obsCell = hasObs ? `<td>${obs.toFixed(4)}</td>` : '';
            return `<tr><td><code>${csq}</code></td>${obsCell}<td>${exp.toFixed(4)}</td></tr>`;
          })
          .join('');
        const header = hasObs
          ? '<tr><th>Consequence</th><th>Observed</th><th>Expected</th></tr>'
          : `<tr><th>Consequence</th><th>Expected ${predictorLabel}</th></tr>`;
        return `
          <div class="detail-section-grow">
            <div class="fw-semibold small text-muted mb-1">All scores (${predictorLabel})</div>
            <table class="table table-sm table-bordered csq-table mb-0">
              <thead class="table-light">${header}</thead>
              <tbody>${rows}</tbody>
            </table>
          </div>`;
      })()
    : '';

  // Missense predictor scores — single-row observed vs expected for missense consequence
  const misScoreTableHtml = (gene.obs_mis_score !== null || gene.exp_mis_score !== null)
    ? (() => {
        const predictorLabel = MIS_SCORE_PREDICTOR ?? 'Mis. Score';
        return `
          <div class="detail-section">
            <div class="fw-semibold small text-muted mb-1">Missense scores (${predictorLabel})</div>
            <table class="table table-sm table-bordered csq-table mb-0">
              <thead class="table-light"><tr><th>Consequence</th><th>Observed</th><th>Expected</th></tr></thead>
              <tbody>
                <tr>
                  <td><code>missense</code></td>
                  <td>${fmtNum(gene.obs_mis_score, 4)}</td>
                  <td>${fmtNum(gene.exp_mis_score, 4)}</td>
                </tr>
              </tbody>
            </table>
          </div>`;
      })()
    : '';

  // QC section — missing-annotation rates and site-filtering percentage
  const qcRows = [
    gene.pct_missing_all !== null && gene.pct_missing_all !== undefined && SCORE_PREDICTOR
      ? `<tr><td>Missing annotation (${SCORE_PREDICTOR})</td><td>${(gene.pct_missing_all * 100).toFixed(1)}%</td></tr>`
      : '',
    gene.pct_missing_mis !== null && gene.pct_missing_mis !== undefined && MIS_SCORE_PREDICTOR
      ? `<tr><td>Missing annotation (${MIS_SCORE_PREDICTOR})</td><td>${(gene.pct_missing_mis * 100).toFixed(1)}%</td></tr>`
      : '',
    gene.pct_filtered !== null && gene.pct_filtered !== undefined
      ? `<tr><td>Sites filtered (%)</td><td>${(gene.pct_filtered * 100).toFixed(1)}%</td></tr>`
      : '',
  ].filter(Boolean);
  const qcHtml = qcRows.length > 0
    ? `
      <div class="mt-2">
        <div class="fw-semibold small text-muted mb-1">QC</div>
        <table class="table table-sm table-bordered csq-table mb-0">
          <thead class="table-light"><tr><th>Metric</th><th>Value</th></tr></thead>
          <tbody>${qcRows.join('')}</tbody>
        </table>
      </div>`
    : '';

  const statsHtml = `
    <div class="detail-sections">
      <div class="detail-section">
        <div class="fw-semibold small text-muted mb-1">DNM counts</div>
        <table class="table table-sm table-bordered csq-table mb-0">
          <thead class="table-light"><tr><th>Metric</th><th>Value</th></tr></thead>
          <tbody>
            <tr><td>Observed</td> <td>${gene.nb_observed_dnms !== null ? gene.nb_observed_dnms : '<span class="text-muted">N/A</span>'}</td></tr>
            <tr><td>Expected</td> <td>${fmtNum(gene.nb_expected_dnms, 2)}</td></tr>
          </tbody>
        </table>
      </div>
      ${simCsqHtml}
      ${simScoreHtml}
      ${misScoreTableHtml}
      <div class="detail-section">
        <div class="fw-semibold small text-muted mb-1">Clustering</div>
        <table class="table table-sm table-bordered csq-table mb-0">
          <thead class="table-light"><tr><th>Metric</th><th>Value</th></tr></thead>
          <tbody>
            <tr><td>Mode</td>       <td>${gene.clustering_mode ?? '—'}</td></tr>
            <tr><td>Missense DNMs</td><td>${gene.clustering_nb_mis_variants ?? '—'}</td></tr>
            <tr><td>Distance</td>  <td>${fmtNum(gene.clustering_dist, 1)}</td></tr>
          </tbody>
        </table>
      </div>
    </div>
    ${qcHtml}`;

  // Per-variant DNM table — only present for significant genes
  const dnmListHtml = gene.observed_dnms
    ? (() => {
        const CSQ_COLOURS = {
          missense: '#0d6efd', nonsense: '#dc3545', frameshift: '#dc3545',
          splice_lof: '#fd7e14', splice_region: '#ffc107', inframe: '#6f42c1',
          start_lost: '#d63384', stop_lost: '#d63384', synonymous: '#6c757d',
          stop_retained: '#6c757d',
        };
        const scoreLabel    = SCORE_PREDICTOR    ?? 'Score';
        const misScoreLabel = MIS_SCORE_PREDICTOR ?? 'Mis. Score';
        const hasMisScore = gene.observed_dnms.some(v => v.mis_score !== undefined && v.mis_score !== null);
        const rows = gene.observed_dnms.map(v => {
          const col = CSQ_COLOURS[v.consequence] ?? '#6c757d';
          const csqBadge = `<span style="color:${col};font-weight:600">${v.consequence}</span>`;
          const misScoreCell = hasMisScore
            ? `<td>${v.mis_score !== undefined && v.mis_score !== null ? v.mis_score.toFixed(3) : '—'}</td>`
            : '';
          return `<tr>
            <td>${v.chrom}</td>
            <td>${v.pos.toLocaleString()}</td>
            <td><code>${v.ref}&gt;${v.alt}</code></td>
            <td>${csqBadge}</td>
            <td>${v.score !== undefined && v.score !== null ? v.score.toFixed(3) : '—'}</td>
            ${misScoreCell}
          </tr>`;
        }).join('');
        const misScoreHeader = hasMisScore ? `<th>${misScoreLabel}</th>` : '';
        return `
          <details class="mt-1">
            <summary class="dnm-toggle small fw-semibold text-muted">
              ${gene.observed_dnms.length} observed variant${gene.observed_dnms.length !== 1 ? 's' : ''}
            </summary>
            <div class="mt-2">
              <table class="table table-sm table-bordered csq-table mb-0">
                <thead class="table-light">
                  <tr><th>Chrom</th><th>Pos</th><th>Allele</th><th>Consequence</th><th>${scoreLabel}</th>${misScoreHeader}</tr>
                </thead>
                <tbody>${rows}</tbody>
              </table>
            </div>
          </details>`;
      })()
    : '';

  const symbolHtml = gene.gene_symbol
    ? `<span class="text-muted fw-normal">(${gene.gene_symbol})</span>`
    : '';

  const conf = gene.g2p_confidence ?? 'absent';
  const req  = gene.g2p_allelic_requirement ?? 'absent';
  const isBiallelic = req === 'biallelic' || req.startsWith('biallelic_');
  const g2pBadge = conf !== 'absent'
    ? `<span class="badge g2p-${conf}${isBiallelic ? ' g2p-biallelic' : ''}" title="${req}">${conf}${isBiallelic ? ' (biallelic)' : ''}</span>`
    : '';

  const srcBadgesHtml = (gene.source_lists && gene.source_lists.length > 0)
    ? gene.source_lists.map(srcBadgeHtml).join(' ')
    : '';

  return `
    <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
      <span class="fw-bold">${gene.gene_id}</span>
      ${symbolHtml}
      ${g2pBadge}
      ${srcBadgesHtml}
      <a href="${ensemblHref}" target="_blank" class="small text-decoration-none">
        Ensembl &#8599;
      </a>
    </div>
    ${cautionHtml}
    ${statsHtml}
    ${dnmListHtml}`;
}

// ── DataTables ────────────────────────────────────────────────────────────────

$(document).ready(function () {
  const table = $('#gene-table').DataTable({
    data: GENES,
    order: [[5, 'asc']],
    pageLength: 25,
    language: { search: 'Filter genes:' },
    columns: [
      {
        data: null,
        orderable: false,
        className: 'dt-center',
        defaultContent: '<span class="expand-icon">&#9654;</span>',
      },
      { data: 'gene_id', title: 'Gene ID' },
      {
        data: 'gene_symbol', title: 'Symbol',
        render: d => d ?? '<span class="text-muted">—</span>',
      },
      {
        data: 'g2p_confidence',
        title: '<abbr title="Gene2Phenotype confidence level. Filled badge = monoallelic (dominant) entry; dashed outline = biallelic (recessive) only.">G2P</abbr>',
        render: (d, type, row) => {
          const RANK = { definitive:0, strong:1, moderate:2, limited:3, disputed:4, refuted:5, absent:6 };
          if (type === 'sort') return d !== null ? (RANK[d] ?? 99) : 99;
          const conf = d ?? 'absent';
          const req  = row.g2p_allelic_requirement ?? 'absent';
          const isBiallelic = req === 'biallelic' || req.startsWith('biallelic_');
          const badgeCls = `badge g2p-${conf}${isBiallelic ? ' g2p-biallelic' : ''}`;
          const label    = isBiallelic
            ? `<br><span style="font-size:0.7em;color:#6c757d">biallelic</span>`
            : '';
          return `<span class="${badgeCls}">${conf}</span>${label}`;
        },
      },
      {
        data: 'source_lists',
        title: '<abbr title="Gene panels / source lists this gene belongs to.">Panels</abbr>',
        render: (d, type) => {
          if (type === 'sort') return d && d.length > 0 ? d.join(';') : '';
          if (!d || d.length === 0) return '<span class="text-muted">—</span>';
          return d.map(srcBadgeHtml).join(' ');
        },
      },
      {
        data: 'min_pval',
        title: '<abbr title="Minimum p-value between all-coding and missense-only test.">min p-val</abbr>',
        render: (d, type) => type === 'sort' ? (d ?? 999) : fmtPval(d),
      },
      {
        data: 'enrichment_all_pval',
        title: '<abbr title="Enrichment test p-value — all coding variants. Compares the observed sum of per-variant effect scores against the null expectation. A score-weighted test: each DNM contributes according to its predicted pathogenicity, not as a plain count.">Enrich. all</abbr>',
        render: (d, type) => type === 'sort' ? (d ?? 999) : fmtPval(d),
      },
      {
        data: 'combined_mis_pval',
        title: '<abbr title="Combined missense p-value. Integrates the missense enrichment and spatial clustering p-values (Fisher\'s method), capturing both excess burden and non-random positional clustering of missense DNMs.">Comb. mis</abbr>',
        render: (d, type) => type === 'sort' ? (d ?? 999) : fmtPval(d),
      },
      {
        data: 'enrichment_mis_pval',
        title: '<abbr title="Enrichment test p-value — missense variants only. Same score-weighted approach as Enrich. all, but restricted to missense DNMs and using a missense-specific effect predictor (e.g. AlphaMissense).">Enrich. mis</abbr>',
        render: (d, type) => type === 'sort' ? (d ?? 999) : fmtPval(d),
      },
      {
        data: 'clustering_pval',
        title: '<abbr title="Spatial clustering test p-value. Detects non-random clustering of missense DNMs along the protein sequence. Requires ≥ 2 observed missense DNMs; N/A otherwise.">Clustering</abbr>',
        render: (d, type) => type === 'sort' ? (d ?? 999) : fmtPval(d),
      },
      {
        data: null, orderable: false,
        title: '<abbr title="Observed vs expected sum of effect scores — all coding variants. These are score sums, not raw DNM counts: each variant is weighted by its predicted pathogenicity. Raw counts are shown in the per-gene detail panel.">Obs / Exp (all)</abbr>',
        render: d => fmtRatio(d.observed_all, d.expected_all),
      },
      {
        data: null, orderable: false,
        title: '<abbr title="Observed vs expected sum of effect scores — missense variants only. Same score-weighted approach as Obs / Exp (all), restricted to missense DNMs.">Obs / Exp (mis)</abbr>',
        render: d => fmtRatio(d.observed_mis, d.expected_mis),
      },
      {
        data: 'caution', orderable: true,
        render: (d, type, row) => {
          if (type === 'sort') return d ? 0 : 1;
          if (!d) return '<span class="text-muted">—</span>';
          const tip = row.caution_reasons.join('; ');
          return `<span class="badge bg-warning text-dark"
                        title="${tip}" style="cursor:help">&#9888; Caution</span>`;
        },
      },
    ],
    createdRow: function (row, data) {
      $(row).addClass('gene-row');
      if (data.min_pval !== null && data.min_pval < CORRECTED_THRESHOLD) {
        $(row).addClass('table-success bg-opacity-25');
      }
    },
  });

  // Toggle child row on click
  $('#gene-table tbody').on('click', 'tr.gene-row', function () {
    const tr  = $(this);
    const row = table.row(tr);
    if (row.child.isShown()) {
      row.child.hide();
      tr.removeClass('expanded table-active');
    } else {
      row.child(
        $('<td class="detail-cell" colspan="12">').append(buildDetailHtml(row.data()))
      ).show();
      tr.addClass('expanded table-active');
    }
  });
});
</script>
</body>
</html>
